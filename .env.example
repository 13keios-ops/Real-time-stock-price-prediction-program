APP_ENV=development
APP_NAME=real-time-stock-price-prediction-program
APP_TIMEZONE=Asia/Seoul
RUNTIME_DATA_DIR=./runtime-data

TRADING_MODE=paper
ALLOW_LIVE_ORDERS=false
ENABLE_PAPER_EXECUTION=true
ENABLE_BROKER_PAPER_MIRRORING=false

KIS_APP_KEY_PAPER=
KIS_APP_SECRET_PAPER=
KIS_ACCOUNT_NO_PAPER=
# Optional for paper mode. Leave blank if the KIS paper-account screen has no product code.
KIS_PRODUCT_CODE_PAPER=

KIS_APP_KEY_LIVE=
KIS_APP_SECRET_LIVE=
KIS_ACCOUNT_NO_LIVE=
KIS_PRODUCT_CODE_LIVE=
KIS_HTS_ID=
KIS_CUSTOMER_TYPE=P
KIS_REST_URL_LIVE=https://openapi.koreainvestment.com:9443
KIS_REST_URL_PAPER=https://openapivts.koreainvestment.com:29443
KIS_WS_URL_LIVE=ws://ops.koreainvestment.com:21000
KIS_WS_URL_PAPER=ws://ops.koreainvestment.com:31000

DATABASE_URL=sqlite:///runtime-data/dev.db
ARTIFACT_STORE=jsonl

FEATURE_SET_VERSION=feature-set-v1
MODEL_VERSION_H15=baseline-h15-v1
MODEL_VERSION_H60=baseline-h60-v1
STRATEGY_VERSION=paper-long-only-v1
PORTFOLIO_VERSION=top30-long-only-v1

UNIVERSE_SELECTION_RULE=median_trading_value_top_30
LABEL_THRESHOLD_15=0.35
LABEL_THRESHOLD_60=0.80
MAX_POSITION_PCT=0.08
MAX_OPEN_POSITIONS=5
MIN_SIGNAL_CONFIDENCE=0.58
PAPER_INITIAL_CASH=25000000
MAX_HOLD_MINUTES=20
SLIPPAGE_BPS=3.0
MAX_SPREAD_BPS=15.0
NEW_ENTRY_START=09:15
NEW_ENTRY_END=15:00
FORCED_FLAT_TIME=15:20

CODEX_REVIEW_ENABLED=true
CODEX_REPORT_DIR=./runtime-data/reports/codex
CODEX_REVIEW_SCOPE=intraday|eod|weekly
