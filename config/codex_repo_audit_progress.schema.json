{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "generated_at",
    "run_label",
    "session_status",
    "kis_verification_action",
    "last_run_summary",
    "open_items",
    "resolved_items",
    "next_actions",
    "latest_source_links",
    "latest_artifacts",
    "error"
  ],
  "properties": {
    "generated_at": { "type": "string" },
    "run_label": { "type": "string" },
    "session_status": { "type": "string" },
    "kis_verification_action": { "type": "string" },
    "last_run_summary": { "type": "string" },
    "open_items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "category",
          "title",
          "summary",
          "last_seen",
          "source_files",
          "confidence"
        ],
        "properties": {
          "id": { "type": "string" },
          "status": { "type": "string", "enum": ["open", "deferred"] },
          "category": { "type": "string" },
          "title": { "type": "string" },
          "summary": { "type": "string" },
          "last_seen": { "type": "string" },
          "source_files": { "type": "array", "items": { "type": "string" } },
          "confidence": { "type": "number" }
        }
      }
    },
    "resolved_items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "title", "resolution", "last_seen"],
        "properties": {
          "id": { "type": "string" },
          "status": { "type": "string", "enum": ["resolved"] },
          "title": { "type": "string" },
          "resolution": { "type": "string" },
          "last_seen": { "type": "string" }
        }
      }
    },
    "next_actions": { "type": "array", "items": { "type": "string" } },
    "latest_source_links": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "url", "source_type", "published_at", "reviewed_at"],
        "properties": {
          "title": { "type": "string" },
          "url": { "type": "string" },
          "source_type": { "type": "string" },
          "published_at": { "type": ["string", "null"] },
          "reviewed_at": { "type": "string" }
        }
      }
    },
    "latest_artifacts": { "type": "array", "items": { "type": "string" } },
    "error": { "type": ["string", "null"] }
  }
}
